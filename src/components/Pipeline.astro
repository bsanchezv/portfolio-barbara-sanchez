---
interface Step {
  number: number;
  title: string;
  tool: string;
  description: string;
  color?: string;
}

interface Props {
  steps: Step[];
  title?: string;
}

const { steps, title = 'Pipeline del proyecto' } = Astro.props;
---

<div class="my-8">
  {title && <h4 class="mb-6 font-display text-lg font-semibold text-white">{title}</h4>}
  <div class="grid gap-4 md:grid-cols-3">
    {steps.map((step, index) => (
      <div class="relative">
        {index < steps.length - 1 && (
          <div class="absolute left-1/2 top-8 hidden h-0.5 w-full bg-gradient-to-r from-white/10 to-white/5 md:block" aria-hidden="true" />
        )}
        <div class="card relative z-10 flex flex-col items-center text-center">
          <span
            class="mb-3 flex h-10 w-10 items-center justify-center rounded-full font-display text-sm font-bold text-base"
            style={step.color ? `background-color: ${step.color}; color: #0d0d10` : 'background-color: rgba(212, 93, 158, 0.2); color: #E6A2C7'}
          >
            {step.number}
          </span>
          <p class="font-display text-sm font-semibold text-white">{step.title}</p>
          <p class="mt-1 text-xs font-medium text-accent-pastel">{step.tool}</p>
          <p class="mt-2 text-xs text-gray-400">{step.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>
